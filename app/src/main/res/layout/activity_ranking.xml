<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/monogram"
        android:gravity="center"
        android:text="@string/ranking_title"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textRank1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/monogram"
        android:gravity="center"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/textRank2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/monogram"
        android:gravity="center"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/textRank3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/monogram"
        android:gravity="center"
        android:textSize="36sp" />

    <Button
        android:id="@+id/buttonBackToLevels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/monogram"
        android:textSize="28sp"
        android:text="@string/ranking_back_to_levels" />
</LinearLayout>